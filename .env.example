# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase admin (server/scripts only — never expose in the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# QR
QR_SECRET_KEY=your-qr-secret-key

# Mobile API CORS (comma-separated origins)
# Leave empty for default (http://localhost:3000, http://localhost:8081)
MOBILE_CORS_ORIGINS=

# CORS: Allow ngrok URLs (set to "true" in development)
MOBILE_CORS_ALLOW_NGROK=false

# CORS: Allow all origins (DANGEROUS - only for development!)
MOBILE_CORS_ALLOW_ALL=false

# WebAuthn (biometric step-up verification)
# RP ID binds credentials permanently to this domain (dev: localhost, prod: bare domain)
WEBAUTHN_RP_ID=localhost
# Human-readable relying party name shown by authenticators
WEBAUTHN_RP_NAME=Fichita
# Exact expected origin for ceremonies (scheme + host + port)
WEBAUTHN_ORIGIN=http://localhost:3000
# HMAC secret signing ceremony state cookies (generate with: openssl rand -hex 32)
WEBAUTHN_STATE_SECRET=
